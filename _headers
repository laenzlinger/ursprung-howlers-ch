# Cache static assets for 1 year
/assets/*  Cache-Control: public, max-age=31536000, immutable
/images/*  Cache-Control: public, max-age=31536000, immutable
/audio/*   Cache-Control: public, max-age=31536000, immutable
/presse/*  Cache-Control: public, max-age=31536000, immutable
/style.css Cache-Control: public, max-age=31536000, immutable
/favicon.jpg Cache-Control: public, max-age=31536000, immutable

# HTML pages - no cache (always fresh)
/*.html    Cache-Control: public, max-age=0, must-revalidate